# Salin menjadi .env.web lalu isi. JANGAN commit .env.web ke GitHub.
# Kata sandi database PostgreSQL (buat sendiri, panjang dan acak)
DB_PASSWORD=ganti-dengan-sandi-acak
# Alamat layanan MODEL di server GPU (IP internal kampus), mis. http://10.0.0.20:8000
TB_REMOTE=http://IP-SERVER-GPU:8000
# Kunci yang sama dengan TB_KUNCI di server GPU
TB_KUNCI=ganti-dengan-kunci-acak
# Port website di server Linux
WEB_PORT=8000
