# Salin menjadi .env.gpu lalu isi. JANGAN commit .env.gpu ke GitHub.
# Kunci akses: harus SAMA dengan TB_KUNCI di .env.web server web
TB_KUNCI=ganti-dengan-kunci-acak
# Folder di server GPU yang berisi PJOK/grade_1..6 dan PKN/grade_1..6
FOLDER_ADAPTER=/opt/learningbuddy/adapters
# Folder di server GPU yang berisi ambang_relevan.json (dari hasil_adapter/hasil)
FOLDER_HASIL=/opt/learningbuddy/hasil
# Port layanan model (cukup dibuka untuk server web saja)
MODEL_PORT=8000
# Opsional: token HuggingFace bila unduhan model dibatasi
HF_TOKEN=
